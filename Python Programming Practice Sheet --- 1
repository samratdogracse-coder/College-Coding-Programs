# 13. Armstrong numbers

n = int(input('Enter the number : '))
power = len(str(n))
sum = 0

for i in str(n):
    sum = sum + int(i)**power

if sum == n:
    print('Armstrong number')
else:
    print('Not an Armstrong number')    

